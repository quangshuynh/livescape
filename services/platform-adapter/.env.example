# LiveScape platform adapter configuration.
# Every value below is also the built-in default; command-line flags override them.

# Event server base URL. Loopback only: any other host is refused at startup.
LIVESCAPE_EVENT_SERVER_URL=http://127.0.0.1:8765

# Mapping file. Leave unset to use the bundled demonstration mappings.
# LIVESCAPE_ADAPTER_MAPPINGS=./mappings.toml
