# LiveScape event server configuration.
# Copy to `.env` and adjust if needed; every value below is also the built-in default.

# Bind address. Keep this loopback-only: the control API is unauthenticated.
LIVESCAPE_HOST=127.0.0.1
LIVESCAPE_PORT=8765

# Comma-separated CORS allowlist for the control panel / renderer dev servers.
LIVESCAPE_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

# Scene shown to a renderer that connects before any event has been sent.
LIVESCAPE_DEFAULT_SCENE=city

# uvicorn log level: critical | error | warning | info | debug | trace
LIVESCAPE_LOG_LEVEL=info
