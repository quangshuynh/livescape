# LiveScape control panel configuration.
# Copy to `.env.local` to override. The defaults assume a local event server.

# HTTP base URL of the LiveScape event server.
VITE_LIVESCAPE_API_URL=http://127.0.0.1:8765

# WebSocket endpoint used for the live activity feed and connection indicator.
VITE_LIVESCAPE_WS_URL=ws://127.0.0.1:8765/ws
